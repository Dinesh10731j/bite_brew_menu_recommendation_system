# ============================================================================
# Bite & Brew AI Recommendation Service — Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` for local development. Values here are NOT secrets
# for production; they are safe local development defaults.
#
# IMPORTANT — CORS_ORIGINS / ALLOWED_HOSTS FORMAT:
# These are parsed by Pydantic Settings V2. Use a COMMA-SEPARATED string
# (simplest and most portable across Render/Netlify). A JSON array string is
# also accepted. The value MUST include http://localhost:3000 for local
# frontend development.
# ============================================================================

# --- Application ---
APP_NAME=Bite & Brew AI Recommendation Service
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list of allowed browser Origins (no spaces needed).
# Must include http://localhost:3000 for local frontend dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,https://bitebrew.netlify.app
CORS_ALLOW_CREDENTIALS=false

# --- Trusted Hosts (Host header allowlist) ---
ALLOWED_HOSTS=bitebrew.netlify.app,bite-brew-menu-recommendation-system.onrender.com,localhost,127.0.0.1,0.0.0.0

# --- Database (Neon PostgreSQL, pgvector) ---
# DATABASE_URL=postgresql://user:password@host:5432/bite_brew_db?sslmode=require
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=10.0

# --- Redis (Upstash) ---
# REDIS_URL=rediss://default:password@host:6379
CACHE_TTL_SECONDS=3600
ENABLE_CACHE=true

# --- ML / Embeddings ---
MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Security ---
# Set a strong production secret; never leave the dev placeholder in prod.
# API_KEY_SECRET=changeme-in-production
ENABLE_SECURITY_HEADERS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_ENABLED=true
CSP_DEFAULT_SRC='self'
# connect-src: allow the frontend origin to connect to this backend.
CSP_CONNECT_SRC='self' https://bitebrew.netlify.app

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=100/minute
RECOMMEND_RATE_LIMIT=60/minute
PERSONALIZED_RECOMMEND_RATE_LIMIT=60/minute
EVENT_RATE_LIMIT=120/minute
ORDER_RATE_LIMIT=30/minute
HEALTH_RATE_LIMIT=30/second
