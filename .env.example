# ============================================================
# Bite & Brew AI Recommendation Service — Environment Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to version control.
#
#   cp .env.example .env
# ============================================================

# --- Application Settings ---
APP_NAME="Bite & Brew AI Recommendation Service"
APP_ENV="development"           # development | staging | production
DEBUG=true
LOG_LEVEL="INFO"                # DEBUG | INFO | WARNING | ERROR

# --- Server Settings ---
HOST="0.0.0.0"
PORT=8000

# --- CORS Origins (comma-separated) ---
# Add your React / Express / Next.js frontend origins here
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

# --- Neon PostgreSQL Database (with pgvector extension) ---
# Get this from: https://console.neon.tech → your project → Connection Details
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL="postgresql://your_user:your_password@ep-your-neon-host.aws.neon.tech/your_dbname?sslmode=require"

# --- Database Connection Pool ---
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=10.0

# --- Upstash Redis (TLS) ---
# Get this from: https://console.upstash.io → your Redis database → Details
# Format: rediss://default:<token>@<host>:<port>
REDIS_URL="rediss://default:your_redis_token@your-redis-host.upstash.io:6379"

# --- Redis Cache Settings ---
CACHE_TTL_SECONDS=3600          # Cache TTL in seconds (default: 1 hour)
ENABLE_CACHE=true               # Set false to disable Redis caching globally

# --- ML Embedding Model (SentenceTransformers) ---
MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# --- API Security ---
# Used for X-API-Key header authentication (leave blank to disable in dev)
API_KEY_SECRET="change-me-in-production"
