# ==========================================
# Bite & Brew AI Recommendation Service
# Environment Variables (.env.example)
# Copy to `.env` and fill in real values.
# ==========================================

# ---------- Application ----------
APP_NAME="Bite & Brew AI Recommendation Service"
APP_ENV=development        # development | production
DEBUG=true                 # In production set to false (enables HTTPS redirect)
LOG_LEVEL=INFO

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000

# ---------- CORS ----------
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,https://bitebrew.netlify.app"
CORS_ALLOW_CREDENTIALS=false

# ---------- Trusted Hosts ----------
ALLOWED_HOSTS="bitebrew.netlify.app,localhost,127.0.0.1,0.0.0.0"

# ---------- Database (Neon PostgreSQL) ----------
DATABASE_URL="postgresql://neon_user:neon_password@ep-sample-pooler.us-east-1.aws.neon.tech/bite_brew_db?sslmode=require"
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=10.0

# ---------- Redis (Upstash / Local) ----------
# Leave empty to disable Redis caching & rate-limit storage (uses in-memory fallback)
REDIS_URL=""
CACHE_TTL_SECONDS=3600
ENABLE_CACHE=true

# ---------- Machine Learning / Embeddings ----------
MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# ---------- Security Header (Helmet) ----------
ENABLE_SECURITY_HEADERS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_ENABLED=true
CSP_DEFAULT_SRC="'self'"
CSP_CONNECT_SRC="'self' https://bitebrew.netlify.app"

# ---------- Rate Limiting (slowapi) ----------
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT="100/minute"
RECOMMEND_RATE_LIMIT="60/minute"
PERSONALIZED_RECOMMEND_RATE_LIMIT="60/minute"
EVENT_RATE_LIMIT="120/minute"
ORDER_RATE_LIMIT="30/minute"
HEALTH_RATE_LIMIT="30/second"

# ---------- Security ----------
API_KEY_SECRET="change-me-to-a-long-random-string"
